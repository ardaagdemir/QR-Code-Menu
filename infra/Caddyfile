# Production TLS-termination reverse proxy (see infra/docker-compose.prod.yml).
# Caddy issues/renews Let's Encrypt certificates automatically for the domains below -
# requires them to already resolve (public DNS) to this host and 80/443 reachable from
# the internet. Domains and the ACME contact email come from infra/.env.prod
# (see infra/.env.prod.example) so this file has no environment-specific values.
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	reverse_proxy backend:8080
}

{$CUSTOMER_WEB_DOMAIN} {
	reverse_proxy customer-web:3000
}

{$STAFF_WEB_DOMAIN} {
	reverse_proxy staff-web:3002
}
