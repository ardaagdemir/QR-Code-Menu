# Production values only — NOT real secrets. Copy to .env.prod (gitignored, same as
# .env) in this same infra/ directory and fill in real values:
#   cp .env.prod.example .env.prod
#
# Usage (from the infra/ directory):
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
#
# Every value below is required (no defaults) - docker compose refuses to start if one
# is missing, instead of silently falling back to a localhost/dev value in production.

# --- Domains (must already resolve via public DNS to this host; Caddy needs 80/443
# reachable from the internet to issue Let's Encrypt certificates - see Caddyfile) ---
API_DOMAIN=api.example.com
CUSTOMER_WEB_DOMAIN=order.example.com
STAFF_WEB_DOMAIN=staff.example.com
# Contact email Let's Encrypt uses for expiry/revocation notices.
ACME_EMAIL=ops@example.com

# --- Frontend build-time API origin (must match API_DOMAIN above, browser-facing,
# https - inlined into the JS bundle at build time, see frontend/*/Dockerfile) ---
NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# --- Backend-facing origins allowed to call /api/** with credentials (must match
# CUSTOMER_WEB_DOMAIN/STAFF_WEB_DOMAIN above, https) ---
CORS_ALLOWED_ORIGINS=https://order.example.com,https://staff.example.com

# --- Database ---
POSTGRES_DB=qrmenu
POSTGRES_USER=qrmenu
POSTGRES_PASSWORD=change-me-strong-password

# --- Shared secret for the /internal/** PLATFORM_ADMIN bootstrap API. ---
INTERNAL_ADMIN_TOKEN=change-me-strong-random-token

# --- HMAC secret the mock payment provider signs/verifies webhook bodies with. ---
PAYMENT_MOCK_WEBHOOK_SECRET=change-me-strong-random-secret

# --- MediaStoragePort local adapter's browser-facing origin (must match API_DOMAIN
# above, https - embedded in Product.imageUrl/Expense.receiptImageUrl values). ---
MEDIA_STORAGE_PUBLIC_BASE_URL=https://api.example.com

# --- OwnerNotificationPort email adapter (real SMTP provider, not the dev mailhog
# catcher used by infra/docker-compose.yml). ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
OWNER_NOTIFICATION_FROM_EMAIL=no-reply@example.com

# --- postgres-backup and media-backup sidecars (infra/docker/postgres-backup,
# infra/docker/media-backup) - share the same interval/retention settings. ---
# Optional - defaults below (daily, 7-day retention) apply if unset. Dumps/archives land
# in infra/backups/ and infra/backups/media/ on the host (bind-mounts, not named
# volumes) - back those directories up / copy them off-host yourself (no S3/cloud
# integration here by design).
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=7
