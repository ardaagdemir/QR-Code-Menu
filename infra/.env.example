# Local development example values only — NOT real secrets.
# Copy to .env (in this same infra/ directory) and adjust if needed:
#   cp .env.example .env
# .env is gitignored and must never be committed.

POSTGRES_DB=qrmenu
POSTGRES_USER=qrmenu
POSTGRES_PASSWORD=qrmenu_local_dev_only

# Shared secret for the /internal/** PLATFORM_ADMIN bootstrap API (Milestone 2).
# Required (no default) - change this for anything beyond local development.
INTERNAL_ADMIN_TOKEN=dev-internal-admin-token-change-me

# HMAC secret the mock payment provider (Milestone 5) signs/verifies webhook bodies
# with. Required (no default) - change this for anything beyond local development.
PAYMENT_MOCK_WEBHOOK_SECRET=dev-payment-mock-webhook-secret-change-me

# Gap-analysis #11 (Section 15): OwnerNotificationPort's email adapter. Optional - email
# is not a blocker, so these already have sane defaults (docker-compose's "mailhog" dev
# SMTP catcher, viewable at http://localhost:8025) in application.yml if left unset.
# Point SMTP_HOST/SMTP_PORT/SMTP_USERNAME/SMTP_PASSWORD at a real provider for prod.
# SMTP_HOST=mailhog
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# OWNER_NOTIFICATION_FROM_EMAIL=no-reply@qrmenu.local

# Gap-analysis #15: MediaStoragePort's local adapter (Section 27 - no production storage
# provider chosen yet). Optional - already defaults to http://localhost:8080, the right
# value for local Docker Compose. Only override for a real deployment (the origin
# browsers can actually reach the backend at).
# MEDIA_STORAGE_PUBLIC_BASE_URL=http://localhost:8080

# Production-readiness CRITICAL #4: postgres-backup sidecar (infra/docker/postgres-backup).
# Optional - defaults below are sane for local dev. Dumps land in infra/backups/.
# BACKUP_INTERVAL_SECONDS=86400
# BACKUP_RETENTION_DAYS=7
