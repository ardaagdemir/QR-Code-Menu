# Local development example values only — NOT real secrets.
# Copy to .env (in this same infra/ directory) and adjust if needed:
#   cp .env.example .env
# .env is gitignored and must never be committed.

POSTGRES_DB=qrmenu
POSTGRES_USER=qrmenu
POSTGRES_PASSWORD=qrmenu_local_dev_only

# Shared secret for the /internal/** PLATFORM_ADMIN bootstrap API (Milestone 2).
# Required (no default) - change this for anything beyond local development.
INTERNAL_ADMIN_TOKEN=dev-internal-admin-token-change-me

# HMAC secret the mock payment provider (Milestone 5) signs/verifies webhook bodies
# with. Required (no default) - change this for anything beyond local development.
PAYMENT_MOCK_WEBHOOK_SECRET=dev-payment-mock-webhook-secret-change-me
